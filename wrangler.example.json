{
  "name": "signal-garden",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signal-garden-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
